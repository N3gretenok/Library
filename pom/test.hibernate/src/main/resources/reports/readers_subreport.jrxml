<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="readers_subreport"
              pageWidth="555" pageHeight="600" columnWidth="555"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">

    <field name="studentCardNumber" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="surname" class="java.lang.String"/>
    <field name="borrowedCount" class="java.lang.Integer"/>

    <columnHeader>
        <band height="15">
            <staticText><reportElement x="0" y="0" width="120" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Номер билета]]></text></staticText>
            <staticText><reportElement x="120" y="0" width="150" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Имя]]></text></staticText>
            <staticText><reportElement x="270" y="0" width="180" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Фамилия]]></text></staticText>
            <staticText><reportElement x="450" y="0" width="105" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Книг на руках]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="15">
            <textField><reportElement x="0" y="0" width="120" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{studentCardNumber}]]></textFieldExpression></textField>
            <textField><reportElement x="120" y="0" width="150" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
            <textField><reportElement x="270" y="0" width="180" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{surname}]]></textFieldExpression></textField>
            <textField><reportElement x="450" y="0" width="105" height="15"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{borrowedCount}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>