<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="readers_report"
              pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="30" bottomMargin="30">

    <parameter name="libraryName" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="totalReaders" class="java.lang.Integer"/>
    <parameter name="totalBooksIssued" class="java.lang.Integer"/>

    <field name="studentCardNumber" class="java.lang.String"/>
    <field name="name" class="java.lang.String"/>
    <field name="surname" class="java.lang.String"/>
    <field name="borrowedCount" class="java.lang.Integer"/>

    <title>
        <band height="100">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="20" isBold="true"/></textElement>
                <text><![CDATA[Отчёт по читателям]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="45" width="555" height="20"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{libraryName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="70" width="555" height="20"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="11"/></textElement>
                <textFieldExpression><![CDATA["Дата формирования: " + $P{reportDate}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="95" width="555" height="1"/></line>
        </band>
    </title>

    <pageHeader>
        <band height="60">
            <staticText>
                <reportElement x="0" y="5" width="555" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
                <text><![CDATA[Сводная статистика:]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="270" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA["Всего читателей: " + $P{totalReaders}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="30" width="275" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA["Книг выдано: " + $P{totalBooksIssued}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="55" width="555" height="1"/></line>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="35">
            <staticText>
                <reportElement x="0" y="0" width="555" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
                <text><![CDATA[Список читателей]]></text>
            </staticText>
            <staticText><reportElement x="0" y="15" width="120" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Номер билета]]></text></staticText>
            <staticText><reportElement x="120" y="15" width="100" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Имя]]></text></staticText>
            <staticText><reportElement x="220" y="15" width="120" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Фамилия]]></text></staticText>
            <staticText><reportElement x="340" y="15" width="215" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Книг на руках]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="15">
            <textField><reportElement x="0" y="0" width="120" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{studentCardNumber}]]></textFieldExpression></textField>
            <textField><reportElement x="120" y="0" width="100" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
            <textField><reportElement x="220" y="0" width="120" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{surname}]]></textFieldExpression></textField>
            <textField><reportElement x="340" y="0" width="215" height="15"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{borrowedCount}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <line><reportElement x="0" y="5" width="555" height="1"/></line>
            <textField>
                <reportElement x="0" y="10" width="270" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA["Отчёт сформирован системой «Управление библиотекой»"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="455" y="10" width="100" height="15"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA["Страница " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>