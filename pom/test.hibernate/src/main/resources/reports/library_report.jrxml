<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="library_report"
              pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="libraryName" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="totalBooks" class="java.lang.Integer"/>
    <parameter name="availableBooks" class="java.lang.Integer"/>
    <parameter name="issuedBooks" class="java.lang.Integer"/>
    <parameter name="totalReaders" class="java.lang.Integer"/>

    <field name="cipher" class="java.lang.String"/>
    <field name="title" class="java.lang.String"/>
    <field name="author" class="java.lang.String"/>
    <field name="year" class="java.lang.Integer"/>
    <field name="genre" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>

    <title>
        <band height="120">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Отчёт по библиотеке]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="45" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{libraryName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="70" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Дата формирования: " + $P{reportDate}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="100" width="555" height="1"/></line>
        </band>
    </title>

    <pageHeader>
        <band height="80">
            <staticText>
                <reportElement x="0" y="5" width="555" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
                <text><![CDATA[Сводная статистика:]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="270" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA["Всего книг: " + $P{totalBooks}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="45" width="270" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA["Свободных: " + $P{availableBooks}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="60" width="270" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA["Выдано: " + $P{issuedBooks}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="30" width="275" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA["Всего читателей: " + $P{totalReaders}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="78" width="555" height="1"/></line>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
                <text><![CDATA[Каталог книг]]></text>
            </staticText>
            <staticText><reportElement x="0" y="20" width="60" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Шифр]]></text></staticText>
            <staticText><reportElement x="60" y="20" width="180" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Название]]></text></staticText>
            <staticText><reportElement x="240" y="20" width="130" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Автор]]></text></staticText>
            <staticText><reportElement x="370" y="20" width="50" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Год]]></text></staticText>
            <staticText><reportElement x="420" y="20" width="75" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Жанр]]></text></staticText>
            <staticText><reportElement x="495" y="20" width="60" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement><text><![CDATA[Статус]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="15">
            <textField><reportElement x="0" y="0" width="60" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{cipher}]]></textFieldExpression></textField>
            <textField><reportElement x="60" y="0" width="180" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{title}]]></textFieldExpression></textField>
            <textField><reportElement x="240" y="0" width="130" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{author}]]></textFieldExpression></textField>
            <textField><reportElement x="370" y="0" width="50" height="15"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{year}]]></textFieldExpression></textField>
            <textField><reportElement x="420" y="0" width="75" height="15"/><box><pen lineWidth="0.5"/></box><textElement><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{genre}]]></textFieldExpression></textField>
            <textField><reportElement x="495" y="0" width="60" height="15"/><box><pen lineWidth="0.5"/></box><textElement textAlignment="Center"><font fontName="DejaVu Sans" size="8"/></textElement><textFieldExpression><![CDATA[$F{status}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <line><reportElement x="0" y="5" width="555" height="1"/></line>
            <textField>
                <reportElement x="0" y="10" width="270" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA["Отчёт сформирован системой «Управление библиотекой»"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="455" y="10" width="100" height="15"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA["Страница " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>