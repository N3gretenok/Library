<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="full_report"
              pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="libraryName" class="java.lang.String"/>
    <parameter name="reportDate" class="java.lang.String"/>
    <parameter name="totalBooks" class="java.lang.Integer"/>
    <parameter name="availableBooks" class="java.lang.Integer"/>
    <parameter name="issuedBooks" class="java.lang.Integer"/>
    <parameter name="totalReaders" class="java.lang.Integer"/>
    <parameter name="totalBooksIssued" class="java.lang.Integer"/>
    <parameter name="booksSubreport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="readersSubreport" class="net.sf.jasperreports.engine.JasperReport"/>
    <parameter name="booksDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="readersDataSource" class="net.sf.jasperreports.engine.JRDataSource"/>

    <title>
        <band height="150">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="20" isBold="true"/></textElement>
                <text><![CDATA[Полный отчёт по библиотеке]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="45" width="555" height="20"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{libraryName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="68" width="555" height="20"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="11"/></textElement>
                <textFieldExpression><![CDATA["Дата формирования: " + $P{reportDate}]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="95" width="555" height="1"/></line>

            <staticText>
                <reportElement x="0" y="100" width="555" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="11" isBold="true"/></textElement>
                <text><![CDATA[Сводная статистика:]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="118" width="270" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA["Книг всего: " + $P{totalBooks} + "  (свободно: " + $P{availableBooks} + ", выдано: " + $P{issuedBooks} + ")"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="118" width="275" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="10"/></textElement>
                <textFieldExpression><![CDATA["Читателей: " + $P{totalReaders} + "  (книг на руках: " + $P{totalBooksIssued} + ")"]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="145" width="555" height="1"/></line>
        </band>
    </title>

    <detail>
        <band height="280">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="13" isBold="true"/></textElement>
                <text><![CDATA[КАТАЛОГ КНИГ]]></text>
            </staticText>
            <subreport>
                <reportElement x="0" y="25" width="555" height="250"/>
                <dataSourceExpression><![CDATA[$P{booksDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{booksSubreport}]]></subreportExpression>
            </subreport>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
            <line><reportElement x="0" y="5" width="555" height="1"/></line>
            <textField>
                <reportElement x="0" y="10" width="270" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA["Отчёт сформирован системой «Управление библиотекой»"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="455" y="10" width="100" height="15"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA["Страница " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="280">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement><font fontName="DejaVu Sans" size="13" isBold="true"/></textElement>
                <text><![CDATA[СПИСОК ЧИТАТЕЛЕЙ]]></text>
            </staticText>
            <subreport>
                <reportElement x="0" y="25" width="555" height="250"/>
                <dataSourceExpression><![CDATA[$P{readersDataSource}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{readersSubreport}]]></subreportExpression>
            </subreport>
        </band>
    </summary>
</jasperReport>